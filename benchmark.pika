#! /usr/local/bin/PikaCmd

include('stdlib.pika');
include('systools.pika');
include('debug.pika');

vargs(@me,, @tests, @exe);
if (!exists(@tests) || tests === '-') tests = '*.js';

revs.n = 0;
makeGold = false;
doRevRange = false;
fromRev = toRev = '';
if (tests === 'makegold') {
	makeGold = true;
} else if (exists(@exe)) {
	doRevRange = wildmatch(exe, '{[0-9]?*}-{[0-9]?*}', @fromRev, @toRev);
	if (!doRevRange) {
		if (doRevRange = wildmatch(exe, '{[0-9]?*}', @fromRev)) toRev = fromRev;
	};
//	svn log -r11680:11688 -q NuXJScript.cpp

	if (doRevRange) {
		for (i = fromRev; i <= toRev; ++i) append(@revs, i);
		delete(@exe);
	};
};
if (revs.n == 0) append(@revs, '');

if (PLATFORM === 'UNIX') {
	defaults(@exe, (if (!doRevRange) 'build/Release/NuXJScript -s' else './NuXJScript -s'));
	TIME_COMMAND_FORMAT = '(time -p {exe} benchmarks/{fn} >{outPath}) 2>{timePath}';
	BUILD_CPP_COMMAND = './BuildCpp.sh NuXJScript NuXJScript.cpp';
};

outPath = pipe.newTempPath();
timePath = pipe.newTempPath();

names.n = 0;
widths.n = 0;
dir("benchmarks" # DIR_SLASH # tests, >{
	fn = $0;
	name = basenameOfPath(fn);
	append(@names, name);
	defaults(@widths[name], length(name));
});

iterate(@revs, >{
	rev = $2;
	err = try(>{
		if (rev !== void) {
			print(pipe('svn update -r' # rev # ' NuXJScript.cpp NuXJScript.h'));
			print(pipe(BUILD_CPP_COMMAND));
		};
		iterate(@names, >{
			name = $2;
			fn = name # '.js';
			print(name);
			print(repeat('-', length(name)));
			cmd = bake(TIME_COMMAND_FORMAT);
			rc = system(cmd);
			times = load(timePath);
			output = load(outPath);
			output = replace(output, "\r\n", "\n");
			goldenFile = bake('benchmarks{DIR_SLASH}golden{DIR_SLASH}{name}.txt');
			if (makeGold) {
				save(goldenFile, output);
			} else {
				expected = load(goldenFile);
				if (output != expected) {
					times = 'FAIL';
				}
			};
			print(times);
			tokenize(times, >{ append(@timeLines[name][rev], $0); widths[name] = max(widths[name], length($0)); });
		});
	});
	print(err);
});

prune(@lines);
lines[0] = '        ';
lines[1] = '        ';
lines.n = 2;
iterate(@names, >{
	name = $2;
	lines[0] #= name # repeat(' ', widths[name] - length(name)) # '  ';
	lines[1] #= repeat('-', widths[name]) # '  ';
	lineIndex = 2;
	iterate(@revs, >{
		rev = $2;
		for (l = 0; l < 4; ++l) {
			if (lineIndex >= lines.n) {
				lines[lineIndex] = (if (l == 0) (rev # repeat(' ', 8 - length(rev))) else '        ');
				++lines.n;
			};
			s = coalesce(@timeLines[name][rev][l], '');
			lines[lineIndex] #= s # repeat(' ', widths[name] - length(s)) # '  ';
			++lineIndex;
		}
	});
});
iterate(@lines, >print($2));
