#! /usr/local/bin/PikaCmd

include('stdlib.pika');

vargs(@exe,,@fn);
defaults(@fn, 'stdlib.js');

::textToCpp = function {
    args(@source);
    result = '';
    tokenize(source, >{ if (result != '') result #= LF; result #= TAB # escape($0 # LF) });
   	result
};

save('stdlibJS.cpp', bake(
'const char* STDLIB_JS =
{textToCpp(load(fn))};
'));

print('Updated stdlibJS.cpp');
